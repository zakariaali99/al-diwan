# Copy to .env for local dev, or set these as real env vars / cPanel "Setup
# Python App" environment variables in production. Never commit a real .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://al-diwan.ly,https://www.al-diwan.ly

# --- Database ---
# "sqlite" for zero-config local dev, "mysql" for Docker dev / production.
DATABASE_ENGINE=sqlite
DATABASE_NAME=al_diwan
DATABASE_USER=al_diwan
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=3306

# --- Outbound email (unified inbox — SMTP relay via transactional provider) ---
# console backend just prints emails to stdout; fine for local dev.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=info@al-diwan.ly

# --- Inbound email (unified inbox — IMAP polling, see messaging/management/commands) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
